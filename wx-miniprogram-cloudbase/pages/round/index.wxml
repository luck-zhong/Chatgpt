<view class="container" wx:if="{{game}}">
  <view class="card">
    <view class="row">
      <view class="sub">快捷步进</view>
      <view style="display:flex;gap:8rpx;flex-wrap:wrap;justify-content:flex-end;">
        <view
          wx:for="{{game.settings.stepValues}}"
          wx:key="*this"
          class="badge"
          style="{{step === item ? 'background:#0f62fe;color:#fff;' : ''}}"
          data-value="{{item}}"
          bindtap="selectStep"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <block wx:for="{{game.players}}" wx:key="id">
    <view class="card">
      <view class="row" style="margin-bottom: 10rpx;">
        <view class="title" style="font-size:30rpx;">{{item.name}}</view>
        <view class="sub">当前：{{item.currentScore}}{{game.settings.unit}}</view>
      </view>
      <view class="row" style="gap:10rpx;">
        <button size="mini" data-id="{{item.id}}" data-sign="-1" bindtap="adjust">-{{step}}</button>
        <input class="input" style="flex:1;text-align:center;" type="number" value="{{deltas[item.id]}}" data-id="{{item.id}}" bindinput="onDeltaInput" />
        <button size="mini" data-id="{{item.id}}" data-sign="1" bindtap="adjust">+{{step}}</button>
      </view>
    </view>
  </block>

  <view class="card">
    <view class="sub">标签（可选）</view>
    <view style="display:flex;flex-wrap:wrap;gap:10rpx;margin-top:10rpx;">
      <view wx:for="{{tagOptions}}" wx:key="name" class="badge" style="{{item.selected ? 'background:#0f62fe;color:#fff;' : ''}}" data-idx="{{index}}" bindtap="toggleTag">{{item.name}}</view>
    </view>
    <view class="sub" style="margin-top: 14rpx;">备注</view>
    <input class="input" placeholder="例如：东风圈，自摸" value="{{note}}" bindinput="onNoteInput" />

    <view class="sub" style="margin-top: 14rpx;">本把合计：{{sum}}</view>
    <view class="sub" wx:if="{{game.settings.balanceRequired && sum !== 0}}" style="color:#dc2626;">需平衡后才能保存（当前差值 {{sum}}）</view>

    <button class="btn-primary" style="margin-top: 12rpx;" disabled="{{!canSave}}" loading="{{saving}}" bindtap="onSave">保存本把</button>
  </view>
</view>
