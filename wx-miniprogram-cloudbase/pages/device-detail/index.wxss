.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #5c6675;
  margin-bottom: 8rpx;
}

.input {
  border: 1px solid #d9dde6;
  border-radius: 10rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 18rpx;
  background: #fff;
}

.textarea {
  width: 100%;
  height: 180rpx;
  border: 1px solid #d9dde6;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  background: #fff;
}
